<div class="quiz-landing">
  <div class="landing-hero">
    <div class="landing-logo">
      <span class="logo-icon">&#127793;</span>
      <h1>Rewoven Quiz</h1>
    </div>
    <p class="landing-tagline">Test your sustainability knowledge in a live multiplayer quiz</p>
    <div class="landing-actions">
      <a href="/host" class="btn-landing host">Host a Game</a>
      <a href="/play" class="btn-landing play">Join a Game</a>
    </div>
  </div>

  <div class="landing-features">
    <div class="feature-card">
      <span class="feature-icon">&#127919;</span>
      <h3>144 Questions</h3>
      <p>Covering fashion, food, energy, waste, transport &amp; lifestyle</p>
    </div>
    <div class="feature-card">
      <span class="feature-icon">&#9889;</span>
      <h3>Real-Time</h3>
      <p>Compete live with friends &mdash; faster answers earn more points</p>
    </div>
    <div class="feature-card">
      <span class="feature-icon">&#127942;</span>
      <h3>Leaderboard</h3>
      <p>Track streaks, earn bonuses, and climb to the top</p>
    </div>
  </div>

  <div class="landing-how">
    <h2>How It Works</h2>
    <div class="how-steps">
      <div class="how-step">
        <span class="step-num">1</span>
        <p>Host creates a game and shares the 6-digit PIN</p>
      </div>
      <div class="how-step">
        <span class="step-num">2</span>
        <p>Players join on their phones with the PIN</p>
      </div>
      <div class="how-step">
        <span class="step-num">3</span>
        <p>Answer questions, earn points, and learn about sustainability</p>
      </div>
    </div>
  </div>

  <footer class="landing-footer">
    <p>Built by <strong>Rewoven</strong> &mdash; making sustainability accessible</p>
  </footer>
</div>
